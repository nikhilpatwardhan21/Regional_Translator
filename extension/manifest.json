{
  "manifest_version": 3,
  "name": "Regional Translator & Wispr Flow Dictation",
  "version": "1.1.0",
  "description": "Live tab audio captions & AI voice-to-text dictation into Indian regional languages.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Regional Captions & Dictation"
  },
  "commands": {
    "toggle-dictation": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Toggle Voice Dictation & Typing"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
